ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
RECEIVING_AGENT_ID=receiving-manager@1.0.0
# mock = fixture observations (no photos needed) | live = Claude + real dock photos
RECEIVING_MODE=mock

# Leave ORCH_MODE empty so each agent.json mode is used.
# Do not set ORCH_MODE=inproc on a deploy. That replays the sample catalog.
PORT=8100
OUT_DIR=out
# Set to data/seed to copy the stored Pod 4 Drive runs into an empty OUT_DIR on boot (the Dockerfile does).
SEED_DIR=
ORCH_MODE=
